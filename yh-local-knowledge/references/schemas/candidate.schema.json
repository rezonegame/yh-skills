{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YH Local Knowledge Candidate",
  "type": "object",
  "required": ["id", "type", "status", "title", "sources"],
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": ["concept", "path", "process", "claim", "case", "spec", "other"]
    },
    "status": {
      "type": "string",
      "enum": ["candidate", "rejected", "uncertain", "needs_review"]
    },
    "title": {
      "type": "string"
    },
    "confidence": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
